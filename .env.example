# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Weather APIs - Dual Provider Strategy
# Primary: Open-Meteo (free, 10K requests/day)
VITE_OPENMETEO_API=https://api.open-meteo.com/v1/forecast

# Fallback: WeatherAPI.com (free, 1M requests/month)
# Sign up at https://www.weatherapi.com
# Leave blank if not using (optional)
VITE_WEATHERAPI_KEY=

# Optional: Cloudflare Worker Proxy
# For distributed caching and rate limit protection
# Leave blank to call APIs directly
VITE_PROXY_URL=

# Other APIs
VITE_GEOCODING_API=https://geocoding-api.open-meteo.com/v1/search
VITE_MARINE_API_URL=https://marine-api.open-meteo.com/v1/marine
VITE_NASA_API_URL=https://eonet.gsfc.nasa.gov/api/v3/events

# App Configuration
VITE_APP_NAME=موريتانيا ميتيو
VITE_APP_DESCRIPTION=توقعات الطقس الدقيقة لموريتانيا

# Development
VITE_DEBUG=false

# Strategy:
# 1. Try Open-Meteo (free, fast)
# 2. Fallback to WeatherAPI (if key provided)
# 3. Use cached data (if available)
# 4. Use safe defaults (never crash UI)
